---
import { Code } from 'astro:components';
import { RK_VERSION } from '../consts';
import '../styles/home.css';

const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
const recording = (name: string) => `${baseUrl}recordings/${name}.gif`;
const repoUrl = 'https://github.com/yexiyue/ratatui-kit';
// 中文文档都在 zh-cn/ 前缀下
const docUrl = (href: string) => `${baseUrl}zh-cn/${href}`;

const codeThemes = { light: 'github-light-default', dark: 'github-dark-default' };

// 真实代码：同一计数器的两种写法——左边手写一切，右边只剩状态与 UI。
const rawCode = `fn main() -> std::io::Result<()> {
    let mut terminal = ratatui::init();
    let mut count = 0_u64;
    let mut last = Instant::now();
    loop {
        terminal.draw(|f| ui(f, count))?;
        if last.elapsed() >= Duration::from_secs(1) {
            count += 1;
            last = Instant::now();
        }
        if event::poll(Duration::from_millis(50))? {
            if let Event::Key(k) = event::read()? {
                if k.code == KeyCode::Char('q') {
                    break;
                }
            }
        }
    }
    ratatui::restore();
    Ok(())
}`;

const kitCode = `#[component]
fn Counter(mut hooks: Hooks) -> impl Into<AnyElement<'static>> {
    let mut count = hooks.use_state(|| 0_u64);

    hooks.use_future(async move {
        loop {
            tokio::time::sleep(Duration::from_secs(1)).await;
            count += 1;
        }
    });

    element!(
        Border(border_style: Style::new().yellow()) {
            Text(text: Line::from(format!("Counter: {:02}", count.get())))
        }
    )
}`;

const rawLoc = rawCode.split('\n').length;
const kitLoc = kitCode.split('\n').length;

const runSteps = [
	{
		label: '01 · 添加依赖',
		cmd: 'cargo add ratatui-kit tokio',
		text: '默认不启用任何 feature——按需打开 router、atom、input、tree。',
	},
	{
		label: '02 · 写下组件',
		cmd: 'src/main.rs',
		text: 'use_state 存状态，use_future 跑异步，element! 声明组件树；组件实例跨帧保留。',
	},
	{
		label: '03 · 跑起来',
		cmd: 'cargo run',
		text: '终端进入全屏，计数器每秒 +1，按 q 退出并自动恢复终端。',
	},
];

const modules = [
	{
		token: 'element!',
		title: '声明式语法',
		text: 'JSX 风格的过程宏：if / for / match 在子块里是一等公民，{ expr } 内嵌任意 Rust 表达式，widget() 桥接原生 ratatui widget。',
	},
	{
		token: 'use_state · use_future',
		title: 'Hooks 与状态',
		text: 'use_state、use_future、use_effect 与自定义 hook 按调用顺序组织。状态句柄是 Copy 的，支持 count += 1，组件卸载时自动释放。',
	},
	{
		token: 'use_input_layer',
		title: '输入层互斥',
		text: '事件路由到激活的输入层，而不是广播给每个组件。打开弹窗或进入编辑态，背景自动让出键盘。',
	},
	{
		token: 'Waker',
		title: '响应式渲染',
		text: '状态写入唤醒渲染循环——只在真实变化时重绘，不靠定时器，也不靠手动。',
	},
	{
		token: 'Palette · ThemeOverride',
		title: '主题系统',
		text: '一份共享 Palette 就是全部颜色的唯一来源。换掉它即可重绘整棵组件树，也可以用 Atom 驱动运行时换肤。',
	},
	{
		token: 'RouterProvider · Atom',
		title: '路由与全局状态',
		text: '带历史栈的 Router 管理多个页面；Atom 管理跨页面共享的业务状态。',
	},
];

// 真实代码：examples/input/input_mutex.rs（框架级输入互斥）。
const layerCode = `// Request an input layer when entering edit mode
let edit_layer = hooks.use_input_layer(editing.get(), true);

// The handler only receives key events while this layer is active
hooks.use_event_handler(
    EventScope::Layer(edit_layer),
    EventPriority::High,
    move |event| {
        let Event::Key(key) = event else {
            return EventResult::Ignored;
        };
        match key.code {
            KeyCode::Enter => editing.set(false),
            KeyCode::Char(c) => draft.write().push(c),
            _ => {}
        }
        // The background list never sees these keys
        EventResult::Consumed
    },
);`;

// 全部内置组件：代码取自各组件文档页的真实用法。
const components = [
	{
		name: 'View · Border · Text',
		desc: '弹性容器、带边框分组与段落渲染——把组件树切成可预期终端区域的原语。',
		gif: null,
		href: 'components/layout-primitives/',
		example: 'hello_world',
		code: `View(flex_direction: Direction::Vertical, gap: 1) {
    Text(text: "header")
    View(height: Constraint::Fill(1)) {
        Text(text: "body")
    }
    Text(text: "footer")
}`,
	},
	{
		name: 'ScrollView',
		desc: '超出视口的内容先渲染进更大的缓冲区，再按偏移显示——自带 j/k、翻页与滚动条。',
		gif: 'scrollview',
		href: 'components/scroll-view/',
		example: 'scrollview',
		code: `ScrollView(
    flex_direction: Direction::Vertical,
    block: Block::bordered(),
) {
    for (i, row) in rows.iter().enumerate() {
        View(key: i, height: Constraint::Length(1)) {
            Text(text: row)
        }
    }
}`,
	},
	{
		name: 'WrappedText',
		desc: '按给定宽度硬换行，再把真实行数写回布局高度，让 ScrollView 正确计算滚动范围。',
		gif: 'wrapped-text',
		href: 'components/wrapped-text/',
		example: 'wrapped_text',
		code: `ScrollView(scroll_view_state: scroll_state, block: Block::bordered()) {
    WrappedText(
        text: BODY,
        wrap_width: 72,
        style: Style::new().white(),
    )
}`,
	},
	{
		name: 'Input',
		desc: '渲染 tui_input 状态的单行输入框；写入、提交与退出由页面 handler 驱动。',
		gif: 'input',
		href: 'components/input/',
		example: 'input',
		code: `Border(height: Constraint::Length(3)) {
    Input(
        input: input.read().clone(),
        placeholder: "Type and press Enter".to_string(),
        cursor_style: Style::new().bg(Color::Yellow),
    )
}`,
	},
	{
		name: 'SearchInput',
		desc: '带编辑态的搜索框：按 s 进入输入并开启独占层——激活、提交、校验与互斥全包。',
		gif: 'search-input',
		href: 'components/search-input/',
		example: 'search_input',
		code: `SearchInput(
    value: query.read().to_string(),
    placeholder: "Press s to search".to_string(),
    on_change: move |next: String| query.set(next),
    on_submit: move |value: String| {
        submitted.set(value);
        true
    },
)`,
	},
	{
		name: 'Modal',
		desc: '底层弹层：画背景遮罩、定位内容，并向子树提供当前输入层。',
		gif: 'modal',
		href: 'components/modal/',
		example: 'modal',
		code: `Modal(
    open: open.get(),
    width: Constraint::Length(68),
    height: Constraint::Length(12),
) {
    Border(top_title: Line::from("Details").centered()) {
        Text(text: Line::from("Modal content"))
    }
}`,
	},
	{
		name: 'ConfirmModal',
		desc: '内置独占输入层的确认弹窗：确认/取消、按钮焦点与互斥，由 open 控制。',
		gif: 'confirm-modal',
		href: 'components/confirm-modal/',
		example: 'confirm_modal',
		code: `ConfirmModal(
    open: confirm_open.get(),
    title: Line::from("Delete release?"),
    content: format!("Remove {selected_label}?"),
    confirm_text: "Delete".to_string(),
    on_confirm: move |_: ()| confirm_open.set(false),
    on_cancel: move |_: ()| confirm_open.set(false),
)`,
	},
	{
		name: 'AlertModal',
		desc: '无按钮的通知弹窗：展示消息、触发 on_close，期间拦截下层输入。',
		gif: 'alert-modal',
		href: 'components/alert-modal/',
		example: 'alert_modal',
		code: `AlertModal(
    open: alert_open.get(),
    title: Line::from("Workspace is current"),
    message: format!("{selected_label} is synced."),
    on_close: move |_: ()| alert_open.set(false),
)`,
	},
	{
		name: 'ShortcutInfoModal',
		desc: '按分组的快捷键帮助弹窗：内容超出时内部滚动，同时保持输入互斥。',
		gif: 'shortcut-info-modal',
		href: 'components/shortcut-info-modal/',
		example: 'shortcut_info_modal',
		code: `ShortcutInfoModal(
    open: shortcuts_open.get(),
    title: Line::from("Shortcut reference"),
    sections: vec![ShortcutInfoSection::new(
        "Navigation",
        [("Down", "j"), ("Up", "k")],
    )],
    on_close: move |_: ()| shortcuts_open.set(false),
)`,
	},
	{
		name: 'Select',
		desc: '内部持有 ListState 的单选列表：j/k、方向键、Home/End 与 Enter 变成导航和回调。',
		gif: 'select',
		href: 'components/select/',
		example: 'select',
		code: `Select<&'static str>(
    items: items,
    default_index: Some(1),
    highlight_symbol: "> ",
    empty_message: "No environments",
    on_select: move |item: &'static str| {
        selected.set(item);
    },
)`,
	},
	{
		name: 'MultiSelect',
		desc: '两级交互的多选列表：Space 切换草稿选择（on_change），Enter 提交（on_select）。',
		gif: 'multi-select',
		href: 'components/multi-select/',
		example: 'multi_select',
		code: `MultiSelect<&'static str>(
    items: items,
    highlight_symbol: "> ",
    on_change: move |items: Vec<&'static str>| {
        selected_count.set(items.len());
    },
    on_select: move |items: Vec<&'static str>| {
        submitted.set(items.len());
    },
)`,
	},
	{
		name: 'TreeSelect',
		desc: '基于 tui-tree-widget 的树形选择（tree feature）：折叠展开、路径式选择与输入互斥。',
		gif: 'tree-select',
		href: 'components/tree-select/',
		example: 'tree_select',
		code: `TreeSelect<&'static str>(
    active: true,
    items: demo_items(),
    default_selection: vec!["components", "select"],
    node_open_symbol: "- ",
    node_closed_symbol: "+ ",
    on_select: move |id: &'static str| {
        submitted.set(id);
    },
)`,
	},
	{
		name: 'VirtualList',
		desc: '长列表（virtual-list feature）：只渲染可视窗口——数万行数据配合自定义行渲染。',
		gif: 'virtual-list',
		href: 'components/virtual-list/',
		example: 'virtual_list',
		code: `VirtualList<Line<'static>>(
    item_count: 10_000,
    default_index: Some(42),
    render_item: |ctx: &ListBuildContext| {
        let style = if ctx.is_selected {
            Style::new().black().on_green()
        } else {
            Style::new()
        };
        (Line::styled(format!("row {:05}", ctx.index + 1), style), 1u16)
    },
)`,
	},
	{
		name: 'VirtualMultiSelect',
		desc: '长列表多选的组合范式：VirtualList 管游标与窗口渲染，业务侧维护 HashSet。',
		gif: 'virtual-multi-select',
		href: 'components/virtual-multi-select/',
		example: 'virtual_multi_select',
		code: `VirtualList<Line<'static>>(
    state: list_state,
    item_count: item_count,
    render_item: move |ctx: &ListBuildContext| {
        let mark = if selected.contains(&ctx.index) { "[x]" } else { "[ ]" };
        (Line::styled(format!("{mark} Row {:05}", ctx.index + 1), Style::default()), 1u16)
    },
)`,
	},
];

const pathItems = [
	{
		title: '先跑起来',
		href: 'start/quick-start/',
		text: 'hello world 和计数器，五分钟上手',
	},
	{
		title: '理解核心模型',
		href: 'core/component-model/',
		text: 'element、组件、hooks、上下文与渲染循环',
	},
	{
		title: '处理真实输入',
		href: 'tutorials/input-mutex/',
		text: '弹窗、列表与编辑模式之间的事件归属',
	},
	{
		title: '扩展框架',
		href: 'advanced/custom-hook/',
		text: '属于你自己的 provider、hook 与 widget',
	},
];
---

<div class="rk-home" data-rk-home>
	<!--
		ratatui-kit 首页 — 方向契约（seed 296d2b21，index 3，code-led）
		THESIS：网站本身就是一帧 TUI 应用：产品与页面同一种材料——发丝线面板、等宽铬、琥珀色只给活着的东西。
		OWN-WORLD：深墨青底随滚动逐层加深；方形发丝线面板配等宽盒式标题；Space Grotesk 显示层压 JetBrains Mono 铬；青=结构，琥珀=激活态；终端窗口在两种主题下都保持深色；页面以 vim 式状态行收尾。
		STORY：访客先看终端应用自己运行，再接管它的按键，从页面本身感受到框架的承诺；两栏代码展示样板坍缩；高密度模块网格铺开机制；文件浏览器式目录走完组件；状态行把人送进文档。
		FIRST VIEWPORT：左对齐宣言式 H1 压在通栏实时 todo 终端上（选中行为青色，忠于 todo_app.rs 源码；琥珀只留给实时提示、主 CTA 与弹窗焦点），两枚方形 CTA，按键提示写在终端自己的状态行里。
		FORM：TUI 原生面板，7 个落地方向中的第 3 位。
		FINISH：unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
	-->
	<div class="rk-shell">
		<section class="rk-hero">
			<h1>像写前端一样，写终端应用。</h1>
			<p class="rk-hero__lead">
				组件、Hooks、输入层、路由与全局状态——构建在 Ratatui 与 Tokio
				之上。你只描述 UI，渲染循环交给运行时。
			</p>
			<div class="rk-hero__actions">
				<a class="rk-btn rk-btn--amber" href={docUrl('start/quick-start/')}>
					<span>快速开始</span>
					<span class="rk-btn__arrow" aria-hidden="true">→</span>
				</a>
				<a class="rk-btn rk-btn--line" href={repoUrl} target="_blank" rel="noreferrer">
					<span>github</span>
					<span class="rk-btn__arrow" aria-hidden="true">↗</span>
				</a>
			</div>

			<figure class="rk-term" data-rk-term>
				<div class="rk-term__bar">
					<span class="rk-term__bar-id">ratatui-kit · todo_app.rs</span>
					<span class="rk-term__bar-status" data-rk-term-status>tasks 5 · all</span>
				</div>

				<div
					class="rk-term__app"
					data-rk-term-app
					tabindex="0"
					role="application"
					aria-label="实时 todo 应用演示。按键：j/k 移动，space 切换完成，f 过滤，d 删除，a 新增任务，q 退出。"
				>
					<div class="rk-app">
						<div class="rk-pane">
							<span class="rk-pane__tab">search</span>
							<div class="rk-search__field">
								<span data-rk-search-slot></span>
								<span data-rk-search-prompt>Press a to add a task</span>
								<span class="rk-caret" data-rk-caret aria-hidden="true" hidden></span>
							</div>
						</div>

						<div class="rk-app__main">
							<div class="rk-pane">
								<span class="rk-pane__tab">tasks / <b data-rk-filter>all</b></span>
								<ul class="rk-tasks__list" data-rk-list role="listbox" aria-label="tasks"
									data-initial="Review runtime~0|Record todo app~0|Write docs~0|Check input layers~1|Plan next slice~0"
								></ul>
								<div class="rk-tasks__empty" data-rk-empty hidden>No tasks in this filter</div>
							</div>

							<div class="rk-app__side">
								<div class="rk-pane">
									<span class="rk-pane__tab">state</span>
									<div class="rk-state__rows">
										<div>open: <b data-rk-open>4</b></div>
										<div>done: <b data-rk-done>1</b></div>
										<div>selected: <span data-rk-selected>Review runtime</span></div>
									</div>
								</div>
								<div class="rk-pane">
									<span class="rk-pane__tab">event</span>
									<p class="rk-event__text" data-rk-event>ready</p>
								</div>
							</div>
						</div>
					</div>

					<div class="rk-modal" data-rk-modal hidden>
						<div class="rk-modal__box">
							<p class="rk-modal__title">Delete task?</p>
							<p class="rk-modal__text" data-rk-modal-text></p>
							<div class="rk-modal__btns">
								<button type="button" class="rk-modal__btn" data-rk-modal-del aria-selected="true">Delete</button>
								<button type="button" class="rk-modal__btn" data-rk-modal-keep aria-selected="false">Keep</button>
							</div>
						</div>
					</div>

					<div class="rk-exit" data-rk-exit hidden>
						<p class="rk-exit__title">process exited · terminal restored</p>
						<p>press <kbd>enter</kbd> to restart todo_app</p>
					</div>
				</div>

				<figcaption class="rk-term__status">
					<span>j/k move · space toggle · f filter · d delete · a add · q quit</span>
					<span class="rk-term__hint">这个终端是活的——点它，然后按 j / k</span>
				</figcaption>
			</figure>
		</section>

		<section class="rk-section">
			<div class="rk-panel">
				<span class="rk-panel__tab">quick start</span>
				<header class="rk-versus__head">
					<h2>同一个计数器，去掉全部杂务</h2>
					<p>
						左边是纯 Ratatui：终端、循环、计时器、退出都归你管。右边是
						ratatui-kit：只剩状态和 UI——其余都是运行时的事。
					</p>
					<p class="rk-versus__note">
						<span>纯 ratatui · <b>{rawLoc} 行</b></span>
						<span>ratatui-kit · <b>{kitLoc} 行</b></span>
					</p>
				</header>

				<div class="rk-versus__grid">
					<figure class="rk-code">
						<span class="rk-pane__tab">main.rs · plain ratatui</span>
						<Code code={rawCode} lang="rust" themes={codeThemes} />
					</figure>
					<figure class="rk-code">
						<span class="rk-pane__tab">counter.rs · ratatui-kit</span>
						<Code code={kitCode} lang="rust" themes={codeThemes} />
					</figure>
				</div>

				<div class="rk-run">
					{runSteps.map((step) => (
						<div class="rk-run__step">
							<span class="rk-step__label">{step.label}</span>
							<span class="rk-step__cmd">{step.cmd}</span>
							<p>{step.text}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="rk-section">
			<header>
				<h2>你熟悉的模型，接上终端</h2>
				<p>
					ratatui-kit 不替代
					Ratatui——它补上成长中的终端应用需要的组件、状态与事件层。
				</p>
			</header>
			<div class="rk-grid">
				{modules.map((module) => (
					<article class="rk-module">
						<span class="rk-module__token">{module.token}</span>
						<h3>{module.title}</h3>
						<p>{module.text}</p>
					</article>
				))}
			</div>
		</section>

		<section class="rk-section rk-layers__grid">
			<header>
				<h2>事件按层路由，而不是广播</h2>
				<p>模态打开或进入编辑时，框架把键盘交给该层——背景组件彻底收不到按键。</p>
				<a class="rk-link" href={docUrl('core/input-layers/')}>
					阅读输入层参考 →
				</a>
			</header>

			<div class="rk-layers__demo">
				<div class="rk-depth">
					<div class="rk-depth__rail">
						<div class="rk-depth__ticks">
							<span class="rk-depth__tick"></span>
							<span class="rk-depth__tick rk-depth__tick--active"></span>
							<span class="rk-depth__tick"></span>
						</div>
					</div>
					<div class="rk-depth__stack">
						<div class="rk-depth__layer">
							<span class="rk-depth__name">input layer 1 — search</span>
							<span class="rk-depth__desc">SearchInput 编辑期申请；当前已关闭</span>
						</div>
						<div class="rk-depth__layer rk-depth__layer--active">
							<span class="rk-depth__name">input layer 2 — confirm modal</span>
							<span class="rk-depth__desc">独占：背景列表收不到任何按键</span>
						</div>
						<div class="rk-depth__layer">
							<span class="rk-depth__name">root scope — task list</span>
							<span class="rk-depth__desc">j/k 导航、f 过滤、d 删除</span>
						</div>
						<p class="rk-depth__keys">按键事件 ─▶ <b>第 2 层 · 模态</b>——背景一无所获</p>
					</div>
				</div>

				<figure class="rk-code">
					<span class="rk-pane__tab">input_mutex.rs</span>
					<Code code={layerCode} lang="rust" themes={codeThemes} />
				</figure>
			</div>
		</section>

		<section class="rk-section rk-react__grid">
			<header>
				<h2>一次状态写入，唤醒整个渲染循环</h2>
				<p>一次赋值，所有依赖自动重渲染——没有重绘调用，没有定时器。这个按钮就是全部思想：</p>
			</header>

			<div class="rk-panel rk-tree">
				<span class="rk-panel__tab">counter 组件</span>
				<pre class="rk-tree__lines" aria-live="polite"><span class="rk-tree__root">Counter</span>
├─ Border ───────── count: <b data-rk-count>07</b>
└─ Text ─────────── count: <b data-rk-count>07</b></pre>
				<button type="button" class="rk-btn rk-btn--line rk-tree__btn" data-rk-ripple-btn>
					<span>count += 1</span>
				</button>
			</div>
		</section>

		<section class="rk-section">
			<header>
				<h2>你要的组件，大多已经内置</h2>
				<p>
					{components.length}
					个与业务无关的组件——布局、输入、弹层、选择、虚拟列表——每个都有可运行示例和真实录屏。点击左侧列表，或聚焦后按
					j / k 浏览。
				</p>
			</header>

			<div class="rk-browser" data-rk-browser>
				<div class="rk-browser__list" role="tablist" aria-label="组件列表">
					{components.map((component, index) => (
						<button
							type="button"
							class="rk-browser__item"
							role="tab"
							id={`rk-cmp-tab-${index}`}
							aria-controls={`rk-cmp-panel-${index}`}
							aria-selected={index === 0 ? 'true' : 'false'}
						>
							<span class="rk-browser__mark" aria-hidden="true">&gt;</span>
							<span>{component.name}</span>
							<span class="rk-browser__tag">{component.gif ? 'rec' : '—'}</span>
						</button>
					))}
				</div>

				<div class="rk-browser__stage">
					{components.map((component, index) => (
						<div
							class={`rk-browser__panel${index === 0 ? ' is-active' : ''}${component.gif ? '' : ' rk-browser__panel--single'}`}
							role="tabpanel"
							id={`rk-cmp-panel-${index}`}
							aria-labelledby={`rk-cmp-tab-${index}`}
						>
							<div class="rk-browser__head">
								<p class="rk-browser__desc">{component.desc}</p>
								<a class="rk-link rk-browser__doclink" href={docUrl(component.href)}>
									查看文档 →
								</a>
							</div>
							<figure class="rk-code">
								<span class="rk-pane__tab">{component.example}.rs</span>
								<Code code={component.code} lang="rust" themes={codeThemes} />
							</figure>
							{component.gif && (
								<figure class="rk-browser__gif">
									<span class="rk-browser__gif-bar">cargo run --example {component.example}</span>
									<img
										src={recording(component.gif)}
										alt={`${component.name} 组件录屏`}
										loading="lazy"
										decoding="async"
									/>
								</figure>
							)}
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="rk-section">
			<header>
				<h2>从一个会动的计数器开始</h2>
				<p>然后叠加异步状态、输入层与路由。首页的使命到此为止——接下来交给文档。</p>
			</header>

			<div class="rk-path">
				{pathItems.map((item) => (
					<a class="rk-path__row" href={docUrl(item.href)}>
						<span class="rk-path__mark" aria-hidden="true">›</span>
						<span>
							<span class="rk-path__title">{item.title}</span>
						</span>
						<span class="rk-path__go" aria-hidden="true">→</span>
						<span class="rk-path__text">{item.text}</span>
					</a>
				))}
			</div>

			<div class="rk-panel rk-cta">
				<span class="rk-panel__tab rk-panel__tab--amber">开始使用</span>
				<div class="rk-cta__install">
					<span class="rk-cta__cmd">cargo add ratatui-kit</span>
					<button type="button" class="rk-cta__copy" data-rk-copy data-cmd="cargo add ratatui-kit" data-rest="已复制">复制</button>
				</div>
				<div class="rk-hero__actions">
					<a class="rk-btn rk-btn--amber" href={docUrl('start/quick-start/')}>
						<span>快速开始</span>
						<span class="rk-btn__arrow" aria-hidden="true">→</span>
					</a>
					<a class="rk-btn rk-btn--line" href={docUrl('examples/')}>
						<span>浏览示例</span>
						<span class="rk-btn__arrow" aria-hidden="true">→</span>
					</a>
				</div>
			</div>

			<footer class="rk-statusline">
				<span><b>ratatui-kit</b> v{RK_VERSION} · MIT</span>
				<span>
					<span class="rk-statusline__mode">normal</span>
					{' · '}
					<a href={docUrl('start/')}>文档</a>
					{' · '}
					<a href={repoUrl} target="_blank" rel="noreferrer">github</a>
				</span>
			</footer>
		</section>
	</div>
</div>

