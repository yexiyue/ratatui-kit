---
import { Code } from "astro:components";
import { RK_VERSION } from "../consts";
import "../styles/home.css";
interface Props {
  locale?: "en" | "zh-cn";
}
const zh = Astro.props.locale === "zh-cn";
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const docs = `${base}${zh ? "zh-cn/" : ""}`;
const repo = "https://github.com/yexiyue/ratatui-kit";
const t = zh
  ? {
      eyebrow: "RATATUI 之上的 RUST 组件框架",
      title: ["终端界面，", "从容构建。"],
      intro:
        "在 Ratatui 之上，用组件组织界面，用 Hooks 管理状态，构建更清晰的终端应用。",
      start: "开始构建",
      source: "查看源码",
      below: "基于 Ratatui · 由 Tokio 驱动 · MIT 开源",
      demoLabel: "01 / 实际运行",
      demoTitle: "在终端里，做更多。",
      demoText:
        "从任务管理到鼠标交互，每个画面都来自仓库中可运行的 Rust 示例。",
      play: "播放录屏",
      pause: "暂停录屏",
      recording: "真实终端录屏",
      tutorial: "阅读示例教程",
      codeLabel: "02 / 组件模型",
      codeTitle: "写下界面。\n让状态驱动它。",
      codeText:
        "熟悉的组件、Props 与 Hooks，配合 Rust 的类型系统。保留 Ratatui 的绘制能力，把重复的运行时工作交给框架。",
      codeLink: "了解组件与 Hooks",
      chapterLabel: "03 / 应用基础",
      chapterTitle: "从一个组件，到完整应用。",
      installLabel: "开始 / 安装",
      installTitle: "你的下一个终端应用，\n从这里开始。",
      installText: "默认不启用额外特性。按需开启路由、输入、表格与全局状态。",
      copy: "复制",
      copied: "已复制",
      failed: "复制失败，请手动选择命令",
      all: "浏览全部示例",
    }
  : {
      eyebrow: "A COMPONENT FRAMEWORK BUILT ON RATATUI",
      title: ["Terminal UI.", "Composed."],
      intro:
        "Components and hooks on top of Ratatui. Give your terminal application a clear structure.",
      start: "Start building",
      source: "Explore the source",
      below: "Built on Ratatui · Powered by Tokio · Open source, MIT",
      demoLabel: "01 / IN THE TERMINAL",
      demoTitle: "Small surface. Real possibilities.",
      demoText:
        "Task management, mouse interaction, and data views. Real Rust examples, recorded straight from the terminal.",
      play: "Play recording",
      pause: "Pause recording",
      recording: "Actual terminal recording",
      tutorial: "Read the walkthrough",
      codeLabel: "02 / THE COMPONENT MODEL",
      codeTitle: "Describe the UI.\nMake it reactive.",
      codeText:
        "Components, props, and hooks meet the Rust type system. Keep Ratatui’s drawing power while the framework handles component lifetimes and reactive rendering.",
      codeLink: "Explore components and hooks",
      chapterLabel: "03 / APPLICATION FOUNDATIONS",
      chapterTitle: "From a component to an application.",
      installLabel: "START / INSTALL",
      installTitle: "Your next terminal app\nstarts here.",
      installText:
        "No extra features by default. Opt into routing, input, tables, and shared state when you need them.",
      copy: "Copy",
      copied: "Copied",
      failed: "Copy failed. Select the command manually.",
      all: "Explore all examples",
    };
const demos = [
  {
    id: "todo-app",
    title: zh ? "任务管理" : "Task management",
    name: "todo_app",
    page: "apps/todo-app/",
    text: zh
      ? "组件、筛选与响应式状态，组合成完整的任务应用。"
      : "Components, filters, and reactive state in one complete application.",
  },
  {
    id: "mouse",
    title: zh ? "鼠标交互" : "Mouse interaction",
    name: "mouse",
    page: "core/pointer-events/",
    text: zh
      ? "命中测试、悬停、按下与捕获，让鼠标交互拥有明确边界。"
      : "Hit testing, hover, press, and capture with explicit interaction boundaries.",
  },
  {
    id: "table",
    title: zh ? "数据表格" : "Data tables",
    name: "table",
    page: "components/table/",
    text: zh
      ? "在终端中呈现与浏览结构化数据。"
      : "Present and navigate structured data in the terminal.",
  },
  {
    id: "router",
    title: zh ? "多页路由" : "Routing",
    name: "router",
    page: "tutorials/router/",
    text: zh
      ? "用路由组织页面，让应用导航保持清晰。"
      : "Give multi-page applications a clear navigation structure.",
  },
];
const foundations = zh
  ? [
      [
        "01",
        "状态，有自己的生命周期。",
        "本地 Hooks、异步任务与共享 Atom，为不同作用域选择合适的状态。",
        "core/hooks/",
      ],
      [
        "02",
        "输入，有明确的边界。",
        "集中式事件路由、输入层与指针 Hooks，让弹窗、键盘和鼠标协同工作。",
        "core/pointer-events/",
      ],
      [
        "03",
        "风格，贯穿整个应用。",
        "共享 Palette、组件主题与局部覆盖，让界面保持一致，也保留定制空间。",
        "core/theming/",
      ],
    ]
  : [
      [
        "01",
        "State with a place to live.",
        "Local hooks, async tasks, and shared atoms. Choose state that fits its lifetime.",
        "core/hooks/",
      ],
      [
        "02",
        "Input with clear boundaries.",
        "Central event routing, input layers, and pointer hooks coordinate keyboard and mouse interaction.",
        "core/pointer-events/",
      ],
      [
        "03",
        "One visual language.",
        "Shared palettes, component themes, and local overrides keep the interface consistent and adaptable.",
        "core/theming/",
      ],
    ];
const code = `#[component]
fn Counter(mut hooks: Hooks) -> impl Into<AnyElement<'static>> {
    let mut count = hooks.use_state(|| 0_u64);

    hooks.use_future(async move {
        loop {
            tokio::time::sleep(Duration::from_secs(1)).await;
            count += 1;
        }
    });

    element!(Border {
        Text(text: Line::from(format!("Count: {}", count.get())))
    })
}`;
---

<div class="rk-home">
  <section class="rk-hero rk-shell" aria-labelledby="rk-title">
    <div class="rk-hero-copy">
      <p class="rk-eyebrow">{t.eyebrow}</p>
      <h1 id="rk-title">{t.title[0]}<br /><span>{t.title[1]}</span></h1>
      <p class="rk-intro">{t.intro}</p>
      <div class="rk-actions">
        <a class="rk-primary" href={`${docs}start/quick-start/`}
          >{t.start}<span aria-hidden="true">↗</span></a
        ><a class="rk-text-link" href={repo}
          >{t.source}<span aria-hidden="true">↗</span></a
        >
      </div>
      <p class="rk-meta">{t.below}</p>
    </div>
    <figure class="rk-brand-art">
      <img
        src={`${base}brand/mascot-assembler.webp`}
        alt={zh
          ? "像素风终端构建者：深青色工装的鼠角色正在组合终端组件框架"
          : "A pixel-art rat assembler in teal workwear arranging components inside a terminal frame"}
        width="960"
        height="960"
        fetchpriority="high"
      /><figcaption>
        {zh ? "组件 / 状态 / 布局" : "COMPONENTS / STATE / LAYOUT"}
        <span>v{RK_VERSION}</span>
      </figcaption>
    </figure>
  </section>
  <section class="rk-section rk-shell" aria-labelledby="rk-demo-title">
    <div class="rk-section-head">
      <div>
        <p class="rk-eyebrow">{t.demoLabel}</p><h2 id="rk-demo-title">
          {t.demoTitle}
        </h2>
      </div><p>{t.demoText}</p>
    </div>
    <div
      class="rk-demo-tabs"
      role="tablist"
      aria-label={zh ? "终端示例" : "Terminal examples"}
    >
      {
        demos.map((demo, i) => (
          <button
            id={`tab-${demo.id}`}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`panel-${demo.id}`}
            tabindex={i === 0 ? 0 : -1}
          >
            {demo.title}
          </button>
        ))
      }
    </div>
    {
      demos.map((demo, i) => (
        <div
          id={`panel-${demo.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${demo.id}`}
          hidden={i !== 0}
          tabindex="0"
          class="rk-demo-panel"
        >
          <div class="rk-terminal">
            <>
              <div class="rk-terminal-bar">
                <>
                  <span>{demo.name}.rs</span>
                  <span>{t.recording}</span>
                </>
              </div>
              <img
                src={`${base}brand/${demo.id}-poster.webp`}
                data-src={`${base}recordings/${demo.id}.gif`}
                data-poster={`${base}brand/${demo.id}-poster.webp`}
                alt={`${demo.title}: ${demo.text}`}
                loading="lazy"
              />
            </>
          </div>
          <div class="rk-demo-info">
            <>
              <button
                class="rk-play"
                type="button"
                data-play={t.play}
                data-pause={t.pause}
                aria-pressed="false"
              >
                {t.play}
              </button>
              <p>{demo.text}</p>
              <code>cargo run --example {demo.name}</code>
              <a
                class="rk-text-link"
                href={`${docs}${{ "todo-app": "apps/todo-app/", mouse: "core/pointer-events/", table: "components/table/", router: "tutorials/router/" }[demo.id]}`}
              >
                {t.tutorial}
                <span aria-hidden="true">↗</span>
              </a>
            </>
          </div>
        </div>
      ))
    }
    <a class="rk-all-examples rk-text-link" href={`${docs}examples/`}
      >{t.all}<span aria-hidden="true">↗</span></a
    >
  </section>
  <section
    class="rk-code-section rk-shell rk-section"
    aria-labelledby="rk-code-title"
  >
    <div>
      <p class="rk-eyebrow">{t.codeLabel}</p><h2
        id="rk-code-title"
        class="rk-lines"
      >
        {t.codeTitle}
      </h2><p class="rk-description">{t.codeText}</p><a
        class="rk-text-link"
        href={`${docs}core/hooks/`}
        >{t.codeLink}<span aria-hidden="true">↗</span></a
      >
    </div><div class="rk-code">
      <div class="rk-terminal-bar">
        <span>counter.rs</span><span
          >{zh ? "组件片段" : "Component excerpt"}</span
        >
      </div><Code code={code} lang="rust" theme="github-dark-default" />
    </div>
  </section>
  <section class="rk-shell rk-section" aria-labelledby="rk-foundation-title">
    <p class="rk-eyebrow">{t.chapterLabel}</p><h2 id="rk-foundation-title">
      {t.chapterTitle}
    </h2><div class="rk-foundations">
      {
        foundations.map(([number, title, text, link]) => (
          <a href={`${docs}${link}`}>
            <>
              <span class="rk-number">{number}</span>
              <h3>{title}</h3>
              <p>{text}</p>
              <span class="rk-arrow" aria-hidden="true">
                ↗
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section
    class="rk-install rk-shell rk-section"
    aria-labelledby="rk-install-title"
  >
    <div>
      <p class="rk-eyebrow">{t.installLabel}</p><h2
        id="rk-install-title"
        class="rk-lines"
      >
        {t.installTitle}
      </h2><p class="rk-description">{t.installText}</p>
    </div><div>
      <div class="rk-install-command">
        <code>cargo add ratatui-kit</code><button
          type="button"
          data-copy="cargo add ratatui-kit"
          data-copied={t.copied}
          data-failed={t.failed}>{t.copy}</button
        >
      </div><p class="rk-copy-status" role="status" aria-live="polite"></p><a
        class="rk-primary"
        href={`${docs}start/quick-start/`}
        >{t.start}<span aria-hidden="true">↗</span></a
      >
    </div>
  </section>
  <footer class="rk-footer rk-shell">
    <span
      >RATATUI KIT / {
        zh ? "终端界面，从容构建。" : "TERMINAL UI. COMPOSED."
      }</span
    ><a href={`${repo}/blob/main/LICENSE`}>MIT LICENSE ↗</a>
  </footer>
</div>
<script>
  import "../scripts/home";
</script>
