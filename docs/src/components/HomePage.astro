			</div>

			<div class="rk-panel rk-cta">
				<span class="rk-panel__tab rk-panel__tab--amber">get started</span>
				<div class="rk-cta__install">
					<span class="rk-cta__cmd">cargo add ratatui-kit</span>
					<button type="button" class="rk-cta__copy" data-rk-copy data-cmd="cargo add ratatui-kit" data-rest="copied">copy</button>
				</div>
				<div class="rk-hero__actions">
					<a class="rk-btn rk-btn--amber" href={`${baseUrl}start/quick-start/`}>
						<span>quick start</span>
						<span class="rk-btn__arrow" aria-hidden="true">→</span>
					</a>
					<a class="rk-btn rk-btn--line" href={`${baseUrl}examples/`}>
						<span>browse examples</span>
						<span class="rk-btn__arrow" aria-hidden="true">→</span>
					</a>
				</div>
			</div>

			<footer class="rk-statusline">
				<span><b>ratatui-kit</b> v{RK_VERSION} · MIT</span>
				<span>
					<span class="rk-statusline__mode">normal</span>
					{' · '}
